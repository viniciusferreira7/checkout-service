NODE_ENV=dev
PORT=3336

# Database
# The `DATABASE_*` parts below provision the `docker-compose.yml` Postgres
# container; `DATABASE_URL` is what TypeORM actually connects with, so keep the
# two in sync.
DATABASE_URL="postgres://postgres:postgres@localhost:5439/checkout"
DATABASE_PORT=5439
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=checkout

# JWT
JWT_SECRET=change-me-to-the-users-service-secret-32-plus-chars
JWT_EXPIRES_IN=1s

PRODUCTS_SERVICE_URL="http://localhost:3335"

# RabbitMQ
RABBITMQ_URL="amqp://admin:admin@localhost:5672"
RABBITMQ_QUEUE_PAYMENTS=payment_queue
RABBITMQ_EXCHANGE=payments
RABBITMQ_ROUTING_KEY_PAYMENT_ORDER=payment.order

# Observability (@viniciusferreira7/signals)
# These are read by the `--require @viniciusferreira7/signals/register` preload,
# which runs BEFORE Nest's ConfigModule loads this file. Exporting them in the
# real process environment is therefore required; the entries here document the
# expected values and feed the non-preload fallback path.
OTEL_SERVICE_NAME=checkout-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
